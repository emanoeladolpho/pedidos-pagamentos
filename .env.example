# Copie para .env e troque os valores:  cp .env.example .env
# O .env está no .gitignore — nenhuma credencial real deve ser versionada.

# --- Bancos (um PostgreSQL por serviço) ---
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=troque-esta-senha-orders
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=troque-esta-senha-payments

# --- Keycloak ---
# Porta pública do Keycloak no host (também compõe o "iss" dos tokens)
KEYCLOAK_PORT=8080
# Administrador do console do Keycloak (http://localhost:8080)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha-keycloak
# Senhas dos usuários de demonstração do realm "pedidos" (cliente / admin)
KC_DEMO_USER_PASSWORD=troque-senha-cliente
KC_DEMO_ADMIN_PASSWORD=troque-senha-admin

# --- Grafana (http://localhost:3000) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-grafana

# --- Gateway de pagamento simulado ---
# Probabilidades entre 0 e 1. Valores com centavos .13 sempre recusam e .66 sempre falham (testes determinísticos).
GATEWAY_FAILURE_RATE=0.05
GATEWAY_DECLINE_RATE=0.05
GATEWAY_LATENCY=150ms
GATEWAY_TIMEOUT=2s
